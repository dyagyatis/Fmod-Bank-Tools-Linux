qmake_qmake_qm_files.qrc:
qmake: FORCE
	@$(QMAKE) -o Makefile Fmod_Bank_Tools.pro

qmake_all: FORCE


all: Makefile Fmod_Bank_Tools

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents Fmod_Bank_Tools_en_AU.ts $(DISTDIR)/
	$(COPY_FILE) --parents rc.qrc qmake_qmake_qm_files.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/qt/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents about.h bank_extract.h bank_header.h extract_worker.h fileio.h mainwindow.h rebuild_worker.h settings.h version.h $(DISTDIR)/
	$(COPY_FILE) --parents about.cpp bank_extract.cpp extract_worker.cpp fileio.cpp main.cpp mainwindow.cpp rebuild_worker.cpp settings.cpp $(DISTDIR)/
	$(COPY_FILE) --parents about.ui mainwindow.ui settings.ui $(DISTDIR)/
	$(COPY_FILE) --parents Fmod_Bank_Tools_en_AU.ts $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


