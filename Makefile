		moc_predefs.h \
		/usr/bin/moc
	/usr/bin/moc $(DEFINES) --include /home/dyagyatis/Fmod-Bank-Tools/moc_predefs.h -I/usr/lib/qt/mkspecs/linux-g++ -I/home/dyagyatis/Fmod-Bank-Tools -I/home/dyagyatis/Fmod-Bank-Tools/include -I/usr/include/qt -I/usr/include/qt/QtWidgets -I/usr/include/qt/QtGui -I/usr/include/qt/QtCore -I/usr/include/c++/16.1.1 -I/usr/include/c++/16.1.1/x86_64-pc-linux-gnu -I/usr/include/c++/16.1.1/backward -I/usr/lib/gcc/x86_64-pc-linux-gnu/16.1.1/include -I/usr/local/include -I/usr/include extract_worker.h -o moc_extract_worker.cpp

